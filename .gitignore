# ==============================
# ZYLO Git Ignore
# ==============================

# Python virtual environment
backend/venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables / secrets
.env
.env.*
!.env.example

# Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# AI model weights
ai/*.h5
ai/*.keras